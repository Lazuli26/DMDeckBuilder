rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow write: if (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true) || (request.auth != null && (request.auth.uid in resource.data.owner) &&
      !(request.resource.data.owner != null && !(request.auth.uid in request.resource.data.owner)));

      match /requests/{userId} {
        allow write: if request.auth != null && (
        (request.auth.uid == userId && resource.data.users.includes(request.auth.uid)) ||
        request.auth.uid in resource.data.owner
        );
      }
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      // Writes allowed if requester is the user themselves but they cannot change the 'admin' field,
      // or if the requester is an admin user.
      allow write: if request.auth != null && (
        // Admin users can write any user doc
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
        || (
          // Non-admins can write their own doc but may not change the 'admin' key
          request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['displayName', 'lastLogin', 'admin'])
          && (
            // If the document already exists, the 'admin' value must remain unchanged
            (resource != null && (resource.data.admin == request.resource.data.admin || request.resource.data.admin == false))
            // If creating a new document, the request must not set admin=true
            || (resource == null && (!('admin' in request.resource.data) || request.resource.data.admin == false))
          )
        )
      );
    }
  }
}